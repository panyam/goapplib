{
  "name": "@panyam/tsappkit",
  "version": "0.0.5",
  "description": "TypeScript application toolkit with component lifecycle management, event system, UI utilities, and documentation site components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.mjs",
      "require": "./dist/docs/index.js"
    },
    "./styles/*": "./styles/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "sass styles/docs/DocsPage.scss dist/docs/DocsPage.css --style=expanded && sass styles/docs/DocsPage.scss dist/docs/DocsPage.min.css --style=compressed",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "component",
    "lifecycle",
    "event-bus",
    "ui-toolkit",
    "documentation",
    "docs-components"
  ],
  "author": "panyam",
  "license": "MIT",
  "devDependencies": {
    "ace-builds": "^1.43.0",
    "sass": "^1.77.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "ace-builds": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "ace-builds": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
